RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates coreutils libstdc++6 curl jq && rm -rf /var/lib/apt/lists/*
COPY --from=fetch /tmp/pf/pearlfortune/miner-cuda12 /opt/pearlfortune/miner-cuda12
COPY --from=fetch /tmp/pf/pearlfortune/miner-cuda13 /opt/pearlfortune/miner-cuda13
