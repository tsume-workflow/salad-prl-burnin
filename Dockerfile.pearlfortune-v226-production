RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
ARG PF_SHA256=a5682c28d95097c0f117e76f14304582456343f7e42ad095313251f8486333b2
RUN curl -fsSL --retry 3 --connect-timeout 15 https://github.com/pearlfortune/pearl-miner/releases/download/v2.2.6/pearlfortune-v2.2.6.tar.gz -o /tmp/pf.tar.gz && echo "$PF_SHA256  /tmp/pf.tar.gz" | sha256sum -c - && mkdir /tmp/pf && tar -xzf /tmp/pf.tar.gz -C /tmp/pf --no-same-owner pearlfortune/miner-cuda12 pearlfortune/miner-cuda13
